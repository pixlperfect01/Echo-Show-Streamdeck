<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">

    <item>
        <layer-list>
            <!-- Dark bezel -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#111111" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="#2A2A2C" />
                </shape>
            </item>
            <!-- Gradient key face -->
            <item
                android:left="6dp"
                android:top="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#7B2FF7"
                        android:endColor="#F107A3"
                        android:angle="315" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Clips the ripple to the rounded shape -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>