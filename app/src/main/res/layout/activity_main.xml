<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="TEST"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/deck_background"
        tools:layout_editor_absoluteX="-43dp"
        tools:layout_editor_absoluteY="-40dp" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/layout_1_button_1"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-1"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a1"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_1_button_2"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-2"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a2"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>


            <FrameLayout
                android:id="@+id/layout_1_button_3"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-3"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a3"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_1_button_4"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-4"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a4"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/layout_1_button_5"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-5"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a5"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_1_button_6"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-6"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a6"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_1_button_7"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-7"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a7"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layout_1_button_8"
                android:layout_width="182dp"
                android:layout_height="182dp"
                android:background="@drawable/key_bezel"
                android:clickable="true"
                android:contentDescription="1-8"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="@drawable/key_ripple"
                android:hapticFeedbackEnabled="true"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/a8"
                    app:shapeAppearanceOverlay="@style/KeyFaceCorners" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toTopOf="@+id/linearLayout"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/layout_1_button_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/key_button_white_background"
            android:contentDescription="up"
            android:elevation="6dp"
            android:hapticFeedbackEnabled="true"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_up_arrow"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/layout_1_button_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/key_button_white_background"
            android:contentDescription="down"
            android:elevation="6dp"
            android:hapticFeedbackEnabled="true"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_down_arrow"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/layout_1_button_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/key_button_white_background"
            android:contentDescription="sync"
            android:elevation="6dp"
            android:hapticFeedbackEnabled="true"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sync_arrow"
            android:visibility="visible"
            app:tint="@color/black"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>